<odoo>

    <!-- list / tabular -->
    <record id="ir_ui_view_sf_drug_bud_list" model="ir.ui.view">
        <field name="name">sf_drug list view</field>
        <field name="model">sf_drug_bud</field>
        <field name="arch" type="xml">
            <list string="List String BUD List">
                <field name="sf_solvent_id"/>
                <field name="concentration"/>
<!--                <field name="description"/>-->
                <field name="storage_temperature"/>
<!--                <field name="storage_temperature_min"/>-->
<!--                <field name="storage_temperature_max"/>-->
                <field name="expired_in"/>
                <field name="expired_unit"/>
            </list>
        </field>
    </record>

    <!-- form -->
    <record id="ir_ui_view_sf_drug_bud_form" model="ir.ui.view">
        <field name="name">sf_drug form view</field>
        <field name="model">sf_drug_bud</field>
        <field name="arch" type="xml">
            <form string="Form String BUD">
                <sheet>
                    <group>
                        <field name="sf_solvent_id"/>
                        <field name="concentration"/>
<!--                        <field name="description"/>-->
                        <field name="storage_temperature"/>
<!--                        <field name="storage_temperature_min"/>-->
<!--                        <field name="storage_temperature_max"/>-->
                        <field name="expired_in"/>
                        <field name="expired_unit"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>